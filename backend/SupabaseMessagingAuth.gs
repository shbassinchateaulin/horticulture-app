const SUPABASE_MESSAGING_JWT_PROP='SUPABASE_JWT_SECRET';
const SUPABASE_MESSAGING_JWT_TTL=3600;
function supabaseB64Url_(value){return Utilities.base64EncodeWebSafe(value).replace(/=+$/,'')}
function supabaseUuidForUser_(userId){const props=PropertiesService.getScriptProperties(),key='supabaseUuid:'+String(userId||'');let id=props.getProperty(key);if(id)return id;id=Utilities.getUuid();props.setProperty(key,id);return id}
function supabaseMessagingToken_(b){const userId=String(b.userId||''),generation=String(b.generation||'');const user=sessionUser_(userId);if(!user||user.active===false)return{ok:false,error:'Utilisateur introuvable ou inactif.'};if(!user.email)return{ok:false,error:'Adresse e-mail requise pour la messagerie.'};const serverGeneration=sessionGeneration_(userId);if(!serverGeneration||!generation||generation!==String(serverGeneration))return{ok:false,error:'Session invalide ou expirée.',sessionExpired:true};const secret=PropertiesService.getScriptProperties().getProperty(SUPABASE_MESSAGING_JWT_PROP);if(!secret)return{ok:false,error:'SUPABASE_NOT_CONFIGURED'};const now=Math.floor(Date.now()/1000),header={alg:'HS256',typ:'JWT'},payload={aud:'authenticated',role:'authenticated',sub:supabaseUuidForUser_(userId),email:String(user.email).trim().toLowerCase(),app_user_id:userId,iat:now,exp:now+SUPABASE_MESSAGING_JWT_TTL};const h=supabaseB64Url_(JSON.stringify(header)),p=supabaseB64Url_(JSON.stringify(payload)),sig=Utilities.computeHmacSha256Signature(h+'.'+p,secret,Utilities.Charset.UTF_8),s=Utilities.base64EncodeWebSafe(sig).replace(/=+$/,'');return{ok:true,token:h+'.'+p+'.'+s,expiresAt:(now+SUPABASE_MESSAGING_JWT_TTL)*1000,email:payload.email,userId:userId}}
