const SUPABASE_MESSAGING_JWT_PROP='SUPABASE_JWT_SECRET';
const SUPABASE_MESSAGING_JWT_TTL=3600;
const MESSAGING_SESSION_PREFIX='messagingAuth:';
function supabaseB64Url_(value){return Utilities.base64EncodeWebSafe(value).replace(/=+$/,'')}
function supabaseUuidForUser_(userId){const props=PropertiesService.getScriptProperties(),key='supabaseUuid:'+String(userId||'');let id=props.getProperty(key);if(id)return id;id=Utilities.getUuid();props.setProperty(key,id);return id}
function createMessagingSession_(b){const username=String(b.username||'').trim().toLowerCase(),password=String(b.password||''),remember=!!b.remember;if(!username||!password)return{ok:false,error:'Identifiants manquants.'};const user=listUsers_().find(u=>String(u.username||'').trim().toLowerCase()===username&&u.active!==false);if(!user)return{ok:false,error:'Identifiants invalides.'};if(!user.passwordHash||sha256_(password)!==String(user.passwordHash))return{ok:false,error:'Identifiants invalides.'};if(!user.email)return{ok:false,error:'Adresse e-mail requise pour la messagerie.'};const ticket=Utilities.getUuid()+Utilities.getUuid().replace(/-/g,''),generation=sessionGeneration_(user.id),ttl=remember?30*24*3600*1000:12*3600*1000,expires=Date.now()+ttl,data={userId:String(user.id),generation:String(generation||''),expires:expires};PropertiesService.getScriptProperties().setProperty(MESSAGING_SESSION_PREFIX+sha256_(ticket),JSON.stringify(data));return{ok:true,ticket:ticket,userId:String(user.id),email:String(user.email).trim().toLowerCase(),expiresAt:expires}}
function messagingSession_(ticket){ticket=String(ticket||'');if(!ticket)return null;const props=PropertiesService.getScriptProperties(),key=MESSAGING_SESSION_PREFIX+sha256_(ticket),raw=props.getProperty(key);if(!raw)return null;let data;try{data=JSON.parse(raw)}catch(_){props.deleteProperty(key);return null}if(Date.now()>Number(data.expires||0)){props.deleteProperty(key);return null}const current=sessionGeneration_(data.userId);if(!current||String(current)!==String(data.generation||'')){props.deleteProperty(key);return null}return data}
function supabaseMessagingToken_(b){const ticket=String(b.ticket||''),session=messagingSession_(ticket);if(!session)return{ok:false,error:'MESSAGING_AUTH_REQUIRED',sessionExpired:true};const user=sessionUser_(session.userId);if(!user||user.active===false)return{ok:false,error:'Utilisateur introuvable ou inactif.'};if(!user.email)return{ok:false,error:'Adresse e-mail requise pour la messagerie.'};const secret=PropertiesService.getScriptProperties().getProperty(SUPABASE_MESSAGING_JWT_PROP);if(!secret)return{ok:false,error:'SUPABASE_NOT_CONFIGURED'};const now=Math.floor(Date.now()/1000),header={alg:'HS256',typ:'JWT'},payload={aud:'authenticated',role:'authenticated',sub:supabaseUuidForUser_(user.id),email:String(user.email).trim().toLowerCase(),app_user_id:String(user.id),iat:now,exp:now+SUPABASE_MESSAGING_JWT_TTL};const h=supabaseB64Url_(JSON.stringify(header)),p=supabaseB64Url_(JSON.stringify(payload)),sig=Utilities.computeHmacSha256Signature(h+'.'+p,secret,Utilities.Charset.UTF_8),s=Utilities.base64EncodeWebSafe(sig).replace(/=+$/,'');return{ok:true,token:h+'.'+p+'.'+s,expiresAt:(now+SUPABASE_MESSAGING_JWT_TTL)*1000,email:payload.email,userId:String(user.id)}}
