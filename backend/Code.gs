const SHEET_NAME='Utilisateurs';
const APP_URL='https://shbassinchateaulin.github.io/horticulture-app/';
const RESET_MINUTES=30, CODE_MINUTES=10, REPORT_MINUTES=10080, MAX_CODE_ATTEMPTS=5;
const SESSION_PROP_PREFIX='sessionGeneration:';
const HEADERS=['id','firstName','lastName','email','function','role','username','passwordHash','firstLogin','active','permissions','updatedAt','phone','photo','resetTokenHash','resetExpiresAt','resetCodeHash','resetCodeExpiresAt','resetCodeAttempts','pendingPasswordHash'];
function getSheet_(){const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName(SHEET_NAME);if(!sh)sh=ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0)sh.appendRow(HEADERS);else{const c=sh.getRange(1,1,1,Math.max(sh.getLastColumn(),HEADERS.length)).getValues()[0];HEADERS.forEach((h,i)=>{if(String(c[i]||'')!==h)sh.getRange(1,i+1).setValue(h)})}return sh}
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
function doGet(e){const a=e.parameter.action||'listUsers';if(a==='listUsers')return json_({ok:true,users:listUsers_()});if(a==='listSecurityAlerts')return json_({ok:true,alerts:listSecurityAlerts_()});if(a==='listNotifications')return json_(listNotificationsForUser_(e.parameter.userId||''));if(a==='getSessionState')return json_(getSessionState_(e.parameter.userId||''));if(a==='listAGCampaigns')return json_(agListCampaigns_(e.parameter.userId||'',e.parameter.generation||''));if(a==='getAGDatabaseInfo')return json_(agDatabaseInfo_(e.parameter.userId||'',e.parameter.generation||''));if(a==='listAdherentsAdmin')return json_(adherentsAdminList_());const sr=sortiesRouteGet_(a);if(sr)return json_(sr);return json_({ok:false,error:'Action inconnue'})}
function doPost(e){try{const b=JSON.parse(e.postData.contents||'{}');if(b.action==='createUser')return json_(createUser_(b.user||{}));if(b.action==='updateUser')return json_(updateUser_(b.user||{}));if(b.action==='deleteUser')return json_(deleteUser_(b.id));if(b.action==='saveUsers'){saveUsers_(b.users||[]);return json_({ok:true})}if(b.action==='requestPasswordReset')return json_(requestPasswordReset_(b.email||''));if(b.action==='beginPasswordReset')return json_(beginPasswordReset_(b.token||'',b.password||''));if(b.action==='verifyPasswordResetCode')return json_(verifyPasswordResetCode_(b.token||'',b.code||''));if(b.action==='submitSecurityReport')return json_(submitSecurityReport_(b.token||'',b.reason||'',b.details||''));if(b.action==='resolveSecurityAlert')return json_(resolveSecurityAlert_(b.id||''));if(b.action==='createSecurityTestAlert')return json_(createSecurityTestAlert_(b.userId||'',b.username||''));if(b.action==='markNotificationRead')return json_(markNotificationRead_(b.notificationId||'',b.userId||''));if(b.action==='markAllNotificationsRead')return json_(markAllNotificationsRead_(b.userId||''));if(b.action==='createNotificationTest')return json_(createNotificationTest_(b.userId||''));if(b.action==='createNotification')return json_(createNotification_(b.notification||{}));if(b.action==='sendIntegratedMessage')return json_(sendIntegratedMessage_(b.message||{}));if(b.action==='listIntegratedMessages')return json_(listIntegratedMessages_(b.filter||b.message||{}));if(b.action==='disconnectOtherSessions')return json_(disconnectOtherSessions_(b.userId||'',b.currentGeneration||''));if(b.action==='saveAGCampaign')return json_(agSaveCampaign_(b.campaign||{},b.userId||'',b.generation||''));if(b.action==='deleteAGCampaign')return json_(agDeleteCampaign_(b.campaignId||'',b.userId||'',b.generation||''));if(b.action==='analyzeAGQuestionnaireAI')return json_(agAnalyzeQuestionnaireAI_(b.payload||{},b.userId||'',b.generation||''));if(b.action==='analyzeAGResponsesAI')return json_(agAnalyzeResponsesAI_(b.payload||{},b.userId||'',b.generation||''));if(b.action==='saveAdherentAdmin')return json_(adherentsAdminSave_(b.adherent||{}));if(b.action==='archiveAdherentAdmin')return json_(adherentsAdminArchive_(b.id||'',b.season||''));if(b.action==='importAdherentsAdmin')return json_(adherentsAdminImport_(b.rows||[],b.season||''));const sr=sortiesRoutePost_(b);if(sr)return json_(sr);return json_({ok:false,error:'Action inconnue'})}catch(err){return json_({ok:false,error:String(err)})}}
function listUsers_(){const v=getSheet_().getDataRange().getValues();return v.length<2?[]:v.slice(1).filter(r=>r[0]).map(rowToUser_)}
function rowToUser_(r){return{id:String(r[0]),firstName:String(r[1]||''),lastName:String(r[2]||''),email:String(r[3]||''),function:String(r[4]||''),role:String(r[5]||''),username:String(r[6]||''),passwordHash:String(r[7]||''),firstLogin:String(r[8]).toLowerCase()==='true',active:String(r[9]).toLowerCase()!=='false',permissions:String(r[10]||'').split(',').filter(Boolean),updatedAt:String(r[11]||''),phone:String(r[12]||''),photo:String(r[13]||'')}}
function userRow_(u){return[u.id||'',u.firstName||'',u.lastName||'',u.email||'',u.function||'',u.role||'',u.username||'',u.passwordHash||'',!!u.firstLogin,u.active!==false,(u.permissions||[]).join(','),new Date().toISOString(),u.phone||'',u.photo||'',u.resetTokenHash||'',u.resetExpiresAt||'',u.resetCodeHash||'',u.resetCodeExpiresAt||'',u.resetCodeAttempts||'',u.pendingPasswordHash||'']}
function createUser_(u){if(!u.id||!u.username)return{ok:false,error:'Utilisateur incomplet'};const us=listUsers_();if(us.some(x=>x.id===u.id||x.username.toLowerCase()===String(u.username).toLowerCase()))return{ok:false,error:'Cet utilisateur existe déjà'};getSheet_().appendRow(userRow_(u));return{ok:true,user:u}}
function updateUser_(u){if(!u.id)return{ok:false,error:'ID manquant'};const sh=getSheet_(),v=sh.getDataRange().getValues();for(let i=1;i<v.length;i++)if(String(v[i][0])===String(u.id)){for(let c=14;c<20;c++)u[HEADERS[c]]=String(v[i][c]||'');sh.getRange(i+1,1,1,HEADERS.length).setValues([userRow_(u)]);return{ok:true,user:u}}return{ok:false,error:'Utilisateur introuvable'}}
function deleteUser_(id){if(!id)return{ok:false,error:'ID manquant'};const sh=getSheet_(),v=sh.getDataRange().getValues();for(let i=v.length-1;i>=1;i--)if(String(v[i][0])===String(id)){sh.deleteRow(i+1);return{ok:true}}return{ok:false,error:'Utilisateur introuvable'}}
function saveUsers_(users){const sh=getSheet_(),old=sh.getDataRange().getValues(),tech={};for(let i=1;i<old.length;i++)tech[String(old[i][0])]=old[i].slice(14,20);const rows=users.map(u=>{const t=tech[String(u.id)]||[];for(let c=14;c<20;c++)u[HEADERS[c]]=String(t[c-14]||'');return userRow_(u)});sh.clearContents();sh.appendRow(HEADERS);if(rows.length)sh.getRange(2,1,rows.length,HEADERS.length).setValues(rows)}
function sha256_(t){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(t),Utilities.Charset.UTF_8).map(b=>(b<0?b+256:b).toString(16).padStart(2,'0')).join('')}
function sessionUser_(userId){return listUsers_().find(u=>String(u.id)===String(userId)&&u.active)||null}
function sessionGeneration_(userId){if(!sessionUser_(userId))return null;const p=PropertiesService.getScriptProperties(),k=SESSION_PROP_PREFIX+String(userId);let g=p.getProperty(k);if(!g){g=Utilities.getUuid();p.setProperty(k,g)}return g}
function getSessionState_(userId){const generation=sessionGeneration_(userId);return generation?{ok:true,generation:generation}:{ok:false,error:'Utilisateur introuvable ou inactif'}}
function invalidateUserSessions_(userId){const u=sessionUser_(userId);if(!u)return null;const generation=Utilities.getUuid();PropertiesService.getScriptProperties().setProperty(SESSION_PROP_PREFIX+String(userId),generation);return generation}
function disconnectOtherSessions_(userId,currentGeneration){const serverGeneration=sessionGeneration_(userId);if(!serverGeneration)return{ok:false,error:'Utilisateur introuvable ou inactif'};if(currentGeneration&&String(currentGeneration)!==String(serverGeneration))return{ok:false,error:'Cette session n’est plus valide.',sessionExpired:true,generation:serverGeneration};const generation=invalidateUserSessions_(userId);return{ok:true,generation:generation,message:'Tous les autres appareils ont été déconnectés.'}}
function requestPasswordReset_(email){email=String(email||'').trim().toLowerCase();if(!email)return{ok:false,error:'Renseignez votre adresse e-mail.'};const sh=getSheet_(),v=sh.getDataRange().getValues();let row=-1;for(let i=1;i<v.length;i++)if(String(v[i][3]||'').trim().toLowerCase()===email){row=i;break}if(row<1)return{ok:false,error:"Cette adresse e-mail n’est reliée à aucun compte."};if(String(v[row][9]).toLowerCase()==='false')return{ok:false,error:'Ce compte a été résilié.'};const token=Utilities.getUuid()+Utilities.getUuid().replace(/-/g,''),expires=new Date(Date.now()+RESET_MINUTES*60000).toISOString();sh.getRange(row+1,15).setValue(sha256_(token));sh.getRange(row+1,16).setValue(expires);sh.getRange(row+1,17,1,4).clearContent();const first=String(v[row][1]||''),link=APP_URL+'?reset='+encodeURIComponent(token);MailApp.sendEmail({to:email,subject:'Réinitialisation de votre mot de passe',body:'Bonjour '+first+'\n\nOuvrez ce lien pour choisir votre nouveau mot de passe :\n'+link+'\n\nLien valable '+RESET_MINUTES+' minutes.',htmlBody:'<div style="font-family:Arial;max-width:600px;margin:auto;color:#173126"><h2 style="color:#07583f">Société d’Horticulture et d’Art Floral du Bassin de Châteaulin</h2><p>Bonjour '+escapeHtml_(first)+',</p><p>Ouvrez le lien sécurisé ci-dessous pour choisir votre nouveau mot de passe.</p><p style="margin:28px 0"><a href="'+link+'" style="background:#08744f;color:#fff;text-decoration:none;padding:13px 20px;border-radius:10px;font-weight:bold">Modifier mon mot de passe</a></p><p>Ce lien est valable '+RESET_MINUTES+' minutes.</p></div>',name:"Société d’Horticulture du Bassin de Châteaulin"});return{ok:true,message:'Un lien de réinitialisation a été envoyé par e-mail.'}}
function findResetRow_(token){const v=getSheet_().getDataRange().getValues(),wanted=sha256_(String(token||''));for(let i=1;i<v.length;i++)if(String(v[i][14]||'')===wanted)return{i:i,v:v};return null}
function beginPasswordReset_(token,password){password=String(password||'');if(password.length<8)return{ok:false,error:'Le mot de passe doit contenir au moins 8 caractères.'};const f=findResetRow_(token);if(!f)return{ok:false,error:'Ce lien est invalide ou a déjà été utilisé.'};const r=f.v[f.i];if(Date.now()>Date.parse(String(r[15]||''))){getSheet_().getRange(f.i+1,15,1,6).clearContent();return{ok:false,error:'Ce lien a expiré. Faites une nouvelle demande.'}}const code=String(Math.floor(100000+Math.random()*900000)),sh=getSheet_();sh.getRange(f.i+1,17).setValue(sha256_(code));sh.getRange(f.i+1,18).setValue(new Date(Date.now()+CODE_MINUTES*60000).toISOString());sh.getRange(f.i+1,19).setValue(0);sh.getRange(f.i+1,20).setValue(sha256_(password));const first=String(r[1]||'');MailApp.sendEmail({to:String(r[3]),subject:'Votre code de sécurité',body:'Bonjour '+first+'\n\nVotre code de validation est : '+code+'\n\nIl est valable '+CODE_MINUTES+' minutes. Ne communiquez ce code à personne.',htmlBody:'<div style="font-family:Arial;max-width:600px;margin:auto;color:#173126"><h2 style="color:#07583f">Code de sécurité</h2><p>Bonjour '+escapeHtml_(first)+',</p><p>Pour confirmer votre nouveau mot de passe, saisissez ce code dans l’application :</p><div style="font-size:32px;font-weight:bold;letter-spacing:8px;background:#eef7f2;padding:18px;text-align:center;border-radius:12px">'+code+'</div><p>Ce code est valable '+CODE_MINUTES+' minutes. Ne le communiquez à personne.</p></div>',name:"Société d’Horticulture du Bassin de Châteaulin"});return{ok:true,message:'Un code à 6 chiffres vient de vous être envoyé par e-mail.'}}
function verifyPasswordResetCode_(token,code){const f=findResetRow_(token);if(!f)return{ok:false,error:'Session de réinitialisation invalide.'};const r=f.v[f.i],sh=getSheet_(),attempts=Number(r[18]||0);if(attempts>=MAX_CODE_ATTEMPTS)return{ok:false,error:'Trop de tentatives. Demandez un nouveau lien.'};if(Date.now()>Date.parse(String(r[17]||''))){sh.getRange(f.i+1,17,1,4).clearContent();return{ok:false,error:'Le code a expiré. Demandez un nouveau code.'}}if(sha256_(String(code||''))!==String(r[16]||'')){sh.getRange(f.i+1,19).setValue(attempts+1);return{ok:false,error:'Code incorrect. Il vous reste '+Math.max(0,MAX_CODE_ATTEMPTS-attempts-1)+' tentative(s).'}}const pending=String(r[19]||'');if(!pending)return{ok:false,error:'Aucun nouveau mot de passe en attente.'};sh.getRange(f.i+1,8).setValue(pending);sh.getRange(f.i+1,9).setValue(false);sh.getRange(f.i+1,12).setValue(new Date().toISOString());sh.getRange(f.i+1,15,1,6).clearContent();invalidateUserSessions_(String(r[0]));const reportToken=Utilities.getUuid()+Utilities.getUuid().replace(/-/g,''),props=PropertiesService.getScriptProperties();props.setProperty('securityReport:'+sha256_(reportToken),JSON.stringify({id:String(r[0]),firstName:String(r[1]||''),lastName:String(r[2]||''),email:String(r[3]||''),expires:Date.now()+REPORT_MINUTES*60000}));const reportLink=APP_URL+'?securityReport='+encodeURIComponent(reportToken);MailApp.sendEmail({to:String(r[3]),subject:'Votre mot de passe a été modifié',body:'Bonjour '+String(r[1]||'')+'\n\nVotre mot de passe vient d’être modifié.\n\nSi vous n’êtes pas à l’origine de ce changement, signalez-le ici : '+reportLink,htmlBody:'<div style="font-family:Arial;max-width:600px;margin:auto;color:#173126"><h2 style="color:#07583f">Mot de passe modifié</h2><p>Bonjour '+escapeHtml_(String(r[1]||''))+',</p><p>Votre mot de passe vient d’être modifié.</p><p>Si vous êtes à l’origine de ce changement, aucune action n’est nécessaire.</p><p style="margin:28px 0"><a href="'+reportLink+'" style="background:#b42318;color:#fff;text-decoration:none;padding:13px 20px;border-radius:10px;font-weight:bold">Ce n’était pas moi</a></p></div>',name:"Société d’Horticulture du Bassin de Châteaulin"});return{ok:true,message:'Votre mot de passe a été modifié.'}}
function submitSecurityReport_(token,reason,details){const props=PropertiesService.getScriptProperties(),key='securityReport:'+sha256_(String(token||'')),raw=props.getProperty(key);if(!raw)return{ok:false,error:'Ce lien de signalement est invalide ou a déjà été utilisé.'};const data=JSON.parse(raw);if(Date.now()>Number(data.expires||0)){props.deleteProperty(key);return{ok:false,error:'Ce lien de signalement a expiré.'}}reason=String(reason||'').trim();details=String(details||'').trim();if(!reason)return{ok:false,error:'Sélectionnez une raison.'};const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName('Alertes sécurité');if(!sh){sh=ss.insertSheet('Alertes sécurité');sh.appendRow(['id','userId','firstName','lastName','email','reason','details','status','createdAt'])}const alertId=Utilities.getUuid();sh.appendRow([alertId,data.id,data.firstName,data.lastName,data.email,reason,details,'NOUVELLE',new Date().toISOString()]);const superAdmins=listUsers_().filter(u=>String(u.role).toLowerCase().replace(/[^a-z]/g,'').includes('superadmin')&&u.active&&u.email);superAdmins.forEach(u=>MailApp.sendEmail({to:u.email,subject:'ALERTE - Activité suspecte signalée',body:'Une activité suspecte a été signalée sur le compte de '+data.firstName+' '+data.lastName+'.\n\nMotif : '+reason+'\n\nExplication : '+(details||'Aucune précision')+'\n\nConsultez la gestion des comptes dans l’application.',name:"Société d’Horticulture du Bassin de Châteaulin"}));props.deleteProperty(key);return{ok:true,message:'Votre signalement a été transmis au Super Admin.'}}
function securityAlertSheet_(){const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName('Alertes sécurité');if(!sh){sh=ss.insertSheet('Alertes sécurité');sh.appendRow(['id','userId','firstName','lastName','email','reason','details','status','createdAt'])}return sh}
function createSecurityTestAlert_(userId,username){const users=listUsers_();let u=users.find(x=>String(x.id)===String(userId));if(!u&&username)u=users.find(x=>String(x.username||'').toLowerCase()===String(username).toLowerCase());if(!u||!(String(u.role||'').toLowerCase().replace(/[^a-z]/g,'').includes('superadmin')||String(u.function||'').toLowerCase().replace(/[^a-z]/g,'').includes('superadmin')||String(u.username||'').toLowerCase()==='superadmin'))return{ok:false,error:'Test réservé au Super Admin.'};const id=Utilities.getUuid();securityAlertSheet_().appendRow([id,u.id,u.firstName||'Super',u.lastName||'Admin',u.email||'','TEST — Activité suspecte','Alerte de test serveur : aucun mot de passe n’a été modifié.','NOUVELLE',new Date().toISOString()]);return{ok:true,id:id,message:'Alerte test créée sur le serveur.'}}
function listSecurityAlerts_(){const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Alertes sécurité');if(!sh||sh.getLastRow()<2)return[];return sh.getDataRange().getValues().slice(1).filter(r=>r[0]).map(r=>({id:String(r[0]),userId:String(r[1]),firstName:String(r[2]||''),lastName:String(r[3]||''),reason:String(r[5]||''),details:String(r[6]||''),status:String(r[7]||''),createdAt:String(r[8]||'')})).sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt)))}
function resolveSecurityAlert_(id){const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Alertes sécurité');if(!sh)return{ok:false,error:'Alerte introuvable'};const v=sh.getDataRange().getValues();for(let i=1;i<v.length;i++)if(String(v[i][0])===String(id)){sh.getRange(i+1,8).setValue('TRAITÉE');return{ok:true}}return{ok:false,error:'Alerte introuvable'}}
function escapeHtml_(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function autoriserEnvoiEmail(){return MailApp.getRemainingDailyQuota()}