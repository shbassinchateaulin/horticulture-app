// SortiesExtras.gs — import IA de participants + feuille d'appel + création simplifiée HelloAsso
const SORTIES_ATTENDANCE_SHEET='Présences sorties';
function sortiesAttendanceSheet_(){const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName(SORTIES_ATTENDANCE_SHEET);if(!sh)sh=ss.insertSheet(SORTIES_ATTENDANCE_SHEET);if(sh.getLastRow()===0)sh.appendRow(['participantId','sortieId','status','updatedAt']);return sh}
function sortiesAttendanceList_(sortieId){const sh=sortiesAttendanceSheet_(),v=sh.getDataRange().getValues();return{ok:true,attendance:v.slice(1).filter(r=>r[0]&&(!sortieId||String(r[1])===String(sortieId))).map(r=>({participantId:String(r[0]),sortieId:String(r[1]),status:String(r[2]||'pending'),updatedAt:String(r[3]||'')}))}}
function sortiesAttendanceSet_(sortieId,participantId,status){status=String(status||'pending');if(!['pending','present','late','absent'].includes(status))return{ok:false,error:'Statut invalide'};const sh=sortiesAttendanceSheet_(),v=sh.getDataRange().getValues(),now=new Date().toISOString();let row=0;for(let i=1;i<v.length;i++)if(String(v[i][0])===String(participantId)&&String(v[i][1])===String(sortieId)){row=i+1;break}if(row)sh.getRange(row,1,1,4).setValues([[participantId,sortieId,status,now]]);else sh.appendRow([participantId,sortieId,status,now]);const f=sortiesParticipantFindRow_(participantId);if(f){const isHere=status==='present'||status==='late';f.sh.getRange(f.row,11).setValue(isHere);f.sh.getRange(f.row,12).setValue(isHere?now:'');f.sh.getRange(f.row,17).setValue(now)}sortiesHistoryAdd_(sortieId,'Appel : '+status+' — '+participantId);return{ok:true,status:status}}
function sortiesImportAiSchema_(){return{type:'OBJECT',required:['participants'],properties:{participants:{type:'ARRAY',items:{type:'OBJECT',required:['firstName','lastName'],properties:{firstName:{type:'STRING'},lastName:{type:'STRING'},address:{type:'STRING'},phone:{type:'STRING'},email:{type:'STRING'},places:{type:'NUMBER'},paid:{type:'BOOLEAN'}}}},warnings:{type:'ARRAY',items:{type:'STRING'}}}}}
function sortiesAnalyzeImportAI_(payload){payload=payload||{};const parts=[{text:["Tu extrais une liste de participants à une sortie de la Société d'Horticulture et d'Art Floral du Bassin de Châteaulin.",'Analyse le document, tableau, PDF, photo ou scan fourni.','Une personne = un objet distinct. Récupère uniquement prénom, nom, adresse, téléphone, e-mail, nombre de places et paiement si explicitement indiqué.','Ne crée aucune donnée absente. Ignore titres, totaux, commentaires et lignes vides.','Réponds uniquement selon le schéma JSON demandé.'].join('\n')}];if(payload.file&&payload.file.data){try{parts.push(agAiFilePart_(payload.file))}catch(e){return{ok:false,error:String(e.message||e)}}}if(String(payload.text||'').trim())parts.push({text:'CONTENU :\n'+String(payload.text).slice(0,120000)});if(parts.length<2)return{ok:false,error:'Aucun document à analyser.'};const r=agAiCall_(parts,sortiesImportAiSchema_());if(!r.ok)return r;const rows=Array.isArray(r.data&&r.data.participants)?r.data.participants:[];return rows.length?{ok:true,participants:rows,warnings:r.data.warnings||[],model:r.model}:{ok:false,error:'Aucun participant détecté.'}}
function sortiesImportAiSave_(sortieId,payload){const a=sortiesAnalyzeImportAI_(payload);if(!a.ok)return a;let added=0,duplicates=0,errors=0;const existing=sortiesParticipantsRows_().filter(x=>x.sortieId===String(sortieId));a.participants.forEach(p=>{const email=String(p.email||'').trim().toLowerCase(),phone=String(p.phone||'').trim(),fn=String(p.firstName||'').trim(),ln=String(p.lastName||'').trim();const dup=existing.find(x=>(email&&x.email.toLowerCase()===email)||(phone&&x.phone===phone)||(fn&&ln&&x.firstName.toLowerCase()===fn.toLowerCase()&&x.lastName.toLowerCase()===ln.toLowerCase()));if(dup){duplicates++;return}const r=sortiesParticipantCapacitySave_({sortieId:sortieId,firstName:fn,lastName:ln,email:email,phone:phone,address:String(p.address||''),places:Number(p.places||1),paid:p.paid===true,source:'Import IA'});if(r.ok){added++;existing.push(r.participant)}else errors++});sortiesHistoryAdd_(sortieId,'Import IA : '+added+' ajouté(s), '+duplicates+' doublon(s) ignoré(s)');return{ok:true,added:added,duplicates:duplicates,errors:errors,warnings:a.warnings||[]}}

function sortiesDescriptionFallback_(p){p=p||{};const title=String(p.title||'cette sortie').trim(),location=String(p.location||'').trim(),bits=['La Société d’Horticulture et d’Art Floral du Bassin de Châteaulin vous propose '+title+'.'];if(String(p.description||'').trim())bits.push(String(p.description).trim());if(location)bits.push('Rendez-vous : '+location+'.');bits.push('L’inscription est obligatoire dans la limite des places disponibles.');return bits.join('\n\n')}
function sortiesAccessFallback_(p){const location=String(p&&p.location||'').trim();return location?'Lieu de rendez-vous : '+location+'. Consultez votre application de navigation pour préparer votre trajet.':'Accès non renseigné.'}
function sortiesGenerateDescriptionAI_(p){p=p||{};const fallback=sortiesDescriptionFallback_(p),fallbackAccess=sortiesAccessFallback_(p);try{if(typeof agAiCall_!=='function')return{ok:true,description:fallback,accessInfo:fallbackAccess,fallback:true};const schema={type:'OBJECT',required:['description','accessInfo'],properties:{description:{type:'STRING'},accessInfo:{type:'STRING'}}};const prompt=["Tu prépares la fiche publique d'une sortie de la Société d'Horticulture et d'Art Floral du Bassin de Châteaulin.",'1) Réécris la description en français clair, chaleureux et simple, 2 à 5 courts paragraphes.','2) Génère automatiquement un court bloc Accès / transport à partir du lieu fourni : voiture, stationnement, train ou bus seulement si tu peux l’indiquer sans inventer.','N’invente JAMAIS un numéro de route, une autoroute, une gare, une ligne de bus, un parking ou une durée si tu ne peux pas les déduire avec certitude. Dans ce cas, reste général et conseille de vérifier l’itinéraire.','Ne demande pas à l’administrateur de renseigner les transports : ce bloc doit être généré automatiquement.','Données de la sortie :',JSON.stringify(p)].join('\n');const r=agAiCall_([{text:prompt}],schema);if(r&&r.ok&&r.data)return{ok:true,description:String(r.data.description||fallback).trim()||fallback,accessInfo:String(r.data.accessInfo||fallbackAccess).trim()||fallbackAccess,model:r.model||''};return{ok:true,description:fallback,accessInfo:fallbackAccess,fallback:true}}catch(_){return{ok:true,description:fallback,accessInfo:fallbackAccess,fallback:true}}}
function helloAssoPostJson_(path,payload){const r=UrlFetchApp.fetch(HA_API+path,{method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+helloAssoToken_(),Accept:'application/json'},payload:JSON.stringify(payload||{}),muteHttpExceptions:true});const code=r.getResponseCode(),text=r.getContentText();let j={};try{j=JSON.parse(text||'{}')}catch(_){}if(code<200||code>=300)throw new Error('HelloAsso : '+((j.error&&j.error.message)||j.message||text||('HTTP '+code)));return j}
function sortiesPricingData_(s){try{const p=JSON.parse(String(s.pricing||'{}'));return p&&typeof p==='object'?p:{}}catch(_){return{}}}
function sortiesCreateHelloAsso_(s){s=s||{};const cfg=helloAssoConfig_();if(!cfg.ok)return cfg;const p=sortiesPricingData_(s),title=String(s.title||'').trim();if(!title)return{ok:false,error:'Nom de la sortie manquant'};const desc=String(s.notes||p.description||'').trim(),start=String(p.startDateTime||s.date||''),end=String(p.endDateTime||''),saleEnd=String(p.registrationEnd||end||start||''),cap=Math.max(0,Number(p.capacity||0));const member=Number(p.memberPrice||0),nonMember=Number(p.nonMemberPrice||0),paid=String(p.mode||s.pricing||'free')==='paid'||member>0||nonMember>0;const tiers=paid?[{label:'Tarif adhérent',price:Math.max(0,Math.round(member*100))},{label:'Tarif non-adhérent',price:Math.max(0,Math.round(nonMember*100))}]:[{label:'Inscription gratuite',price:0}];const body={title:title,privateTitle:title,description:desc,longDescription:desc,startDate:start||null,endDate:end||null,saleEndDate:saleEnd||null,tierList:tiers,maxEntries:cap||null,generateTickets:true,displayParticipantsCount:true,displayRemainingEntries:true,allowComment:false,acceptOpenDonation:false,amountVisible:true,widgetButtonText:'S’inscrire'};Object.keys(body).forEach(k=>body[k]===null&&delete body[k]);let j;try{j=helloAssoPostJson_('/organizations/'+encodeURIComponent(cfg.orgSlug)+'/forms/Event/action/quick-create',body)}catch(e){return{ok:false,error:String(e.message||e)}}const slug=String(j.formSlug||j.slug||j.form&&j.form.formSlug||j.form&&j.form.slug||''),fid=String(j.formId||j.id||j.form&&j.form.id||''),url=String(j.url||j.publicUrl||j.formUrl||(slug?'https://www.helloasso.com/associations/'+cfg.orgSlug+'/evenements/'+slug:''));const state=String(j.state||j.form&&j.form.state||'Draft');const updated=Object.assign({},s,{helloassoFormId:fid,helloassoFormSlug:slug,helloassoState:state});const pd=sortiesPricingData_(updated);pd.helloassoUrl=url;updated.pricing=JSON.stringify(pd);const save=sortiesAdminSave_(updated);if(!save.ok)return save;sortiesHistoryAdd_(String(updated.id||save.sortie&&save.sortie.id||''),'Événement HelloAsso créé automatiquement');return{ok:true,helloasso:{id:fid,slug:slug,url:url,state:state},sortie:save.sortie}}
